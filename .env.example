# ============================================
# TECMIS Notice Scraper - Environment Variables
# ============================================

# ---------------------------------------------
# REQUIRED: TECMIS Credentials
# ---------------------------------------------
# Your TECMIS username (student/staff index number)
TECMIS_USER=your_index_number

# Your TECMIS password
TECMIS_PASS=your_password


# ---------------------------------------------
# OPTIONAL: Redis API Configuration
# ---------------------------------------------
# Base URL for your DB Monitor API (Vercel deployment)
# Example: https://db-monitor-api.vercel.app/api/items
# Leave empty if you don't want to sync to Redis
DB_MONITOR_API_URL=

# Authentication token for the API
# This should match the API_TOKEN in your Vercel environment variables
DB_MONITOR_API_TOKEN=


# ---------------------------------------------
# OPTIONAL: Advanced Settings
# ---------------------------------------------
# Set to 1 to skip SSL certificate verification
# Only use if TECMIS certificate expires (rare)
# IGNORE_SSL_ERRORS=1

# Set to 1 to download all PDF/document attachments locally
# Files will be saved to data/attachments/
# Note: GitHub workflow always downloads attachments for Redis sync
# DOWNLOAD_PDFS=1


# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your TECMIS credentials
#
# 3. (Optional) Add Redis API details for cloud sync
#
# 4. Run the scraper:
#    python scrape.py
#
# For GitHub Actions, set these as repository secrets:
# - Settings → Secrets and variables → Actions → New repository secret
# 
# Required secrets:
#   - TECMIS_USER
#   - TECMIS_PASS
#
# Optional secrets (for Redis sync):
#   - DB_MONITOR_API_URL
#   - DB_MONITOR_API_TOKEN
#
